# Database: set DB_ENGINE=mysql (or DATABASE_URL=mysql://...) for persistent production MySQL
DB_ENGINE=sqlite
DATABASE_URL=
MYSQL_DATABASE=cloudbox
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SSL=false

# Cloud Storage: AWS S3 Free Tier (5 GB storage, 20k GET, 2k PUT/month)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=cloudbox-mini-dropbox
AWS_S3_REGION_NAME=ap-south-1
S3_FREE_TIER_GUARD=true
S3_FREE_TIER_MAX_GB=4.5
S3_CORS_ORIGINS=https://cloudbox-mini-dropbox.vercel.app,http://localhost:5173

# Production Security
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://cloudbox-mini-dropbox.vercel.app,http://localhost:5173
DEFAULT_STORAGE_QUOTA_MB=500
